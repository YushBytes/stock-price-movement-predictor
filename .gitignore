# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Jupyter ------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / editor ---------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Claude Code session state ---------------------------------------------
.claude/

# --- OS files -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / local env ---------------------------------------------------
.env
*.local

# --- Data (kept out of git; fetched reproducibly via src/data_loader.py) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Generated artifacts ---------------------------------------------------
# Results CSVs are the project's final deliverable evidence (Option A
# requirement) and are committed so an evaluator can see them without
# re-running anything.
# Figures are committed so the Streamlit dashboard can display them both
# locally and on Streamlit Community Cloud without requiring a notebook run.
# Future generated figures not listed below remain gitignored.
models/*
!models/.gitkeep
figures/*
!figures/.gitkeep
!figures/class_balance.png
!figures/close_with_sma.png
!figures/engineered_confusion_matrix.png
!figures/macd_over_time.png
!figures/predicted_vs_actual.png
!figures/rsi_over_time.png
!figures/spy_close_price.png

# --- Testing / caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
