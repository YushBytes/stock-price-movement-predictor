# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Jupyter ------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / editor ---------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Claude Code session state ---------------------------------------------
.claude/

# --- OS files -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / local env ---------------------------------------------------
.env
*.local

# --- Data (kept out of git; fetched reproducibly via src/data_loader.py) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Generated artifacts ---------------------------------------------------
# Figures are regenerable from the notebook (and already embedded as
# outputs in the committed .ipynb), so they stay out of git. Results CSVs
# are the project's final deliverable evidence (Option A requirement) and
# are committed so an evaluator can see them without re-running anything.
models/*
!models/.gitkeep
figures/*
!figures/.gitkeep

# --- Testing / caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
